# 로컬: SQLite 파일 / 배포: Postgres URL (schema provider와 어댑터도 함께 교체)
DATABASE_URL="file:./prisma/dev.db"

# 관리자 비밀번호 (하드코딩 금지, 여기서만 설정)
ADMIN_PASSWORD=""

# 관리자 세션 쿠키 서명 키: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# "/" 접속 시 이동할 캠페인 slug (선택)
DEFAULT_CAMPAIGN_SLUG=""

# OG 이미지 등 절대 URL의 기준 도메인 (선택 — Vercel이면 배포 도메인으로 자동 추정)
# 예: NEXT_PUBLIC_SITE_URL="https://wishfund.example.com"
NEXT_PUBLIC_SITE_URL=""
