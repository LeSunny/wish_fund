# 로컬: brew postgresql@17 (createdb wish_fund) — 사용자명은 `whoami`, URL에 꼭 넣을 것(Prisma는 기본값 없음) / 배포: Neon pooled URL (Vercel 연동 시 자동 주입)
DATABASE_URL="postgresql://<맥 사용자명>@localhost:5432/wish_fund"
# 마이그레이션용 직접 연결 URL (Neon 연동 시 자동 주입, 로컬은 비워두면 DATABASE_URL 사용)
# DATABASE_URL_UNPOOLED=""

# 관리자 비밀번호 (하드코딩 금지, 여기서만 설정)
ADMIN_PASSWORD=""

# 관리자 세션 쿠키 서명 키: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# "/" 접속 시 이동할 캠페인 slug (선택)
DEFAULT_CAMPAIGN_SLUG=""

# OG 이미지 등 절대 URL의 기준 도메인 (선택 — Vercel이면 배포 도메인으로 자동 추정)
# 예: NEXT_PUBLIC_SITE_URL="https://wishfund.example.com"
NEXT_PUBLIC_SITE_URL=""
