// Prisma schema — wish_fund
// 로컬·배포 모두 Postgres (로컬은 brew postgresql@17, 배포는 Neon)
// 자세한 규칙은 CLAUDE.md 참고

// Prisma 7: 연결 URL은 prisma.config.ts, 런타임 연결은 드라이버 어댑터(src/lib/prisma.ts)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PledgeStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Campaign {
  id          String @id @default(cuid())
  slug        String @unique

  title       String
  description String // 마크다운 허용 (렌더 시 raw HTML은 비허용)

  goalAmount Int // 원 단위
  deadline   DateTime

  // 수동 송금 정보 (결제 연동 없음)
  accountInfo String? // 은행/계좌/예금주
  kakaopayUrl String?
  tossUrl     String?

  status        CampaignStatus @default(DRAFT)
  thanksMessage String? // 성공 페이지 문구

  // 향후 회원 기능 확장용. MVP에서는 항상 null, 코드에서 사용하지 않음
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  pledges  Pledge[]

  @@index([status])
  @@map("campaigns")
}

// 캠페인의 위시리스트 상품 (최대 5개, lib/validation.ts). 후원은 상품별이 아니라 캠페인 전체에 보탠다.
model Product {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title        String
  url          String?
  thumbnailUrl String? // 첫 번째 상품의 썸네일이 공유(OG) 이미지
  price        Int? // 원 단위. 참고용 — 목표 금액 자동 제안에만 쓰고 진행률과는 무관

  sortOrder Int // 0부터. 관리자 폼의 순서 그대로

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, sortOrder])
  @@map("products")
}

model Pledge {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // 수정/취소용 코드. 서버 발급, 전역 unique. "귤-47-딸기" 형태 (lib/pledge-code.ts)
  code String @unique

  displayName String // 닉네임 가능
  isAnonymous Boolean @default(false) // true면 공개 목록에 "익명"으로 표시

  amount         Int // 원 단위
  isAmountPublic Boolean @default(false) // false면 공개 목록에서 금액 숨김 (관리자 화면은 항상 노출)

  message String? // 한 줄 축하 메시지

  status PledgeStatus @default(PENDING)

  // 향후 PG 결제 확장용. MVP에서는 항상 null, 코드에서 사용하지 않음
  paymentMethod String?
  paymentId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@map("pledges")
}
